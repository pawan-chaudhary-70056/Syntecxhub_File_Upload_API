                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/uploads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads"]
            },
            "description": "The field name must be `image`; using `file` should return 400."
          },
          "response": []
        },
