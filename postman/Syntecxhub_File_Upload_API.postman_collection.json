            "url": {
              "raw": "{{baseUrl}}/api/uploads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads"]
            },
            "description": "Only JPEG, PNG, WebP, and GIF images are allowed."
          },
          "response": []
