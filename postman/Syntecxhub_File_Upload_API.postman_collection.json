{
  "info": {
    "_postman_id": "b6f4c2a1-3d5e-4f7a-9c8b-1a2b3c4d5e6f",
    "name": "Syntecxhub File Upload API",
    "description": "Postman collection for the Syntecxhub Back-End Week 1 File/Image Upload API.\n\nEndpoints:\n- GET /api/health\n- POST /api/uploads\n- GET /api/uploads\n- GET /api/uploads/:id\n- GET /uploads/optimized/:filename\n- GET /uploads/thumbnails/:filename\n- DELETE /api/uploads/:id\n- GET /api-docs\n\nBefore uploading, select a JPEG, PNG, WebP, or GIF file (max 2 MB) in the form-data body. The field name must be `image`.\n\nImages are processed with Sharp into optimized WebP files and thumbnails.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('API reports healthy', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.database).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Check that the API and MongoDB connection are alive."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Uploads",
      "item": [
        {
          "name": "Upload Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Returns upload metadata and processed URLs', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.id).to.be.a('string');",
                  "  pm.expect(body.data.filename).to.be.a('string');",
                  "  pm.expect(body.data.url).to.include('/uploads/optimized/');",
                  "  pm.expect(body.data.thumbnailUrl).to.include('/uploads/thumbnails/');",
                  "  pm.expect(body.data.mimetype).to.match(/^image\\//);",
                  "  pm.expect(body.data.width).to.be.a('number');",
                  "  pm.expect(body.data.height).to.be.a('number');",
                  "});",
                  "",
                  "if (body.data && body.data.id) {",
                  "  pm.collectionVariables.set('uploadId', body.data.id);",
                  "}",
                  "",
                  "if (body.data && body.data.url) {",
                  "  pm.collectionVariables.set('optimizedFilename', body.data.url.split('/').pop());",
                  "}",
                  "",
                  "if (body.data && body.data.thumbnailUrl) {",
                  "  pm.collectionVariables.set('thumbnailFilename', body.data.thumbnailUrl.split('/').pop());",
                  "}",
                  "",
                  "if (body.data && body.data.filename) {",
                  "  pm.collectionVariables.set('originalFilename', body.data.filename);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": [],
                  "description": "Select a JPEG, PNG, WebP, or GIF image (max 2 MB)."
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/uploads",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads"]
            },
            "description": "Upload one image. The field name must be `image`."
          },
          "response": []
        },
        {
          "name": "List Uploads",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Returns a data array and pagination metadata', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.pagination).to.have.property('total');",
                  "  pm.expect(body.pagination).to.have.property('page');",
                  "  pm.expect(body.pagination).to.have.property('limit');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/uploads?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "List uploads with pagination. Optionally add `mimetype=image/png`."
          },
          "response": []
        },
        {
          "name": "Get Upload by ID",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Returns the requested upload', function () {",
                  "  pm.expect(body.success).to.eql(true);",
                  "  pm.expect(body.data.id).to.eql(pm.collectionVariables.get('uploadId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/uploads/{{uploadId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads", "{{uploadId}}"]
            },
            "description": "Uses the `uploadId` saved automatically by the Upload Image request."
          },
          "response": []
        },
        {
          "name": "Serve Optimized Image",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is an optimized WebP image', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('image/webp');",
                  "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/uploads/optimized/{{optimizedFilename}}",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "optimized", "{{optimizedFilename}}"]
            },
            "description": "Serves the Sharp-optimized WebP image created during upload."
          },
          "response": []
        },
        {
          "name": "Serve Thumbnail",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is a WebP thumbnail', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('image/webp');",
                  "  pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/uploads/thumbnails/{{thumbnailFilename}}",
              "host": ["{{baseUrl}}"],
              "path": ["uploads", "thumbnails", "{{thumbnailFilename}}"]
            },
            "description": "Serves the generated 200x200 WebP thumbnail."
          },
          "response": []
        },
        {
          "name": "Delete Upload",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Upload deleted successfully', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/uploads/{{uploadId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "uploads", "{{uploadId}}"]
            },
            "description": "Deletes the MongoDB record, the original, the optimized image, and the thumbnail. Run this last."
          },
          "response": []
        }
      ]
    },
