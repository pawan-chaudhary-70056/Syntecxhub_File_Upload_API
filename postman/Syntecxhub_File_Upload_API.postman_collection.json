                  "});",
                  "",
                  "pm.test('Explains the expected field name', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.message.toLowerCase()).to.include('image');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
