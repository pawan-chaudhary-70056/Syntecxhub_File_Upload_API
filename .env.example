# Server
PORT=5000
NODE_ENV=development

# MongoDB (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/syntecxhub_upload

# Public base URL used to build absolute file URLs
BASE_URL=http://localhost:5000

# Comma-separated allowed origins, or * for all
CORS_ORIGIN=*

# Upload settings
UPLOAD_DIR=uploads
# 2 MB in bytes (2 * 1024 * 1024)
MAX_FILE_SIZE=2097152

# Image processing (Sharp)
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1920
THUMBNAIL_SIZE=200
WEBP_QUALITY=82
# 16383 x 16383 pixels - protects against decompression bombs
MAX_IMAGE_PIXELS=268402689
